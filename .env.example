# Server-only credentials. Never use NEXT_PUBLIC_ prefixes for these values.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Optional public origin for a custom reverse proxy. Vercel normally uses request origin.
# APP_ORIGIN=https://your-app.vercel.app
# Optional for Codex proxy-bound DATABASE_URL secrets: Neon HTTPS /sql endpoint.
# NEON_HTTP_ENDPOINT=https://api.your-region.aws.neon.tech/sql

# Gemini Developer API: use a Free tier project in Google AI Studio.
# No OpenAI fallback. OAuth client secrets are NOT API keys.
GEMINI_API_KEY=
# Application limits are independent of Google's project-specific quota.
RAG_DAILY_QUESTIONS=10
RAG_GLOBAL_DAILY_QUESTIONS=20
RAG_DAILY_EMBEDDING_CHARACTERS=200000
RAG_GLOBAL_DAILY_EMBEDDING_CHARACTERS=1000000

# Google SSO (optional; Client ID, Secret, origin and an allowed account type required).
# Register the Web application callback: https://your-app.vercel.app/api/auth/sso/google/callback
# APP_ORIGIN=https://your-app.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Workspace hosted domains, comma-separated. Workspace domains remain restricted even when personal Gmail is enabled.
GOOGLE_WORKSPACE_DOMAINS=

# Explicitly allow verified personal Gmail/googlemail accounts as well. Default false.
GOOGLE_ALLOW_PERSONAL_ACCOUNTS=false
