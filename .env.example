# SQLite and private original files. Default: ./data (never commit this folder).
# DOCUMIND_DATA_DIR=/absolute/path/to/persistent/documind-data
# Public server URL behind a reverse proxy; enables Secure session cookies on HTTPS.
# APP_ORIGIN=https://documind.example.com
# Optional server-only OpenAI key; without it actual source excerpts are returned.
RAG_API_KEY=
RAG_MODEL=gpt-4o-mini
