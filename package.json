{
  "name": "documind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:backend": "tsx --test tests/backend.test.ts tests/google-sso.test.ts tests/rag.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:services": "tsx scripts/check-services.ts",
    "storage:cleanup": "tsx scripts/cleanup-storage.ts",
    "db:import-sqlite": "tsx scripts/import-sqlite.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/noto-sans-kr": "^5.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
